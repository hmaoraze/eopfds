# 配置参考。EdgeOne Makers 在控制台的「环境变量」里逐项配置，不会被平台自动加载本文件。
# 本文件只用于记录清单与本地调试时对照，禁止填入真实密钥后提交到代码库。

# ============ 必填（缺失即 503，业务接口拒绝服务） ============
DEEPSEEK_API_KEY=sk-your-deepseek-key
BLOB_STORE_NAME=chat-memory
SYSTEM_PROMPT=你是「小助手」，一名耐心、简洁的中文助理。
SESSION_TIMEOUT_MS=1800000

# ============ 上游（可选，有默认值） ============
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=20000
# 通道 B 提炼的独立超时与租约（进程被回收后可被维护任务补跑）
DISTILL_TIMEOUT_MS=12000
DISTILL_LOCK_TTL_MS=600000

# ============ 提示词注入（只接受 dual_system | merged_single_system） ============
PROMPT_INJECTION_MODE=dual_system
HISTORY_MAX_MESSAGES=60
TOOL_MAX_ROUNDS=3
SESSION_BUSY_TTL_MS=120000

# ============ 记忆治理 ============
MEMORY_TOOL_ENABLED=true
MEMORY_MAX_ITEMS=500
MEMORY_TTL_MS=7776000000
MEMORY_TOP_K=8
MEMORY_DECAY_LAMBDA=0.02
MEMORY_DEDUP_THRESHOLD=0.82
MEMORY_DEDUP_SCAN_LIMIT=300
MEMORY_HARD_DELETE_AFTER_MS=604800000
MEMORY_SUMMARY_MAX_CHARS=1200

# ============ 管理面（缺失则 /admin/* 返回 503，不影响对话） ============
ADMIN_TOKEN=replace-with-long-random-token
ADMIN_HMAC_SECRET=replace-with-long-random-secret
ADMIN_AUTH_MAX_SKEW_MS=300000
# openid 白名单（可选）。单独使用 openid 可被伪造，必须同时配置网关密钥才会启用该通道。
ADMIN_OPENID_ALLOWLIST=
ADMIN_OPENID_GATEWAY_SECRET=

# ============ 微信 / iLink ============
WECHATBOT_BASE_URL=https://ilinkai.weixin.qq.com
WECHATBOT_TOKEN=
WECHATBOT_WEBHOOK_SECRET=
WECHATBOT_GETUPDATES_PATH=/ilink/bot/getupdates
WECHATBOT_SEND_PATH=/ilink/bot/sendmessage
WECHATBOT_POLL_TIMEOUT_MS=10000

# ============ 定时任务 ============
CRON_SECRET=replace-with-long-random-secret
